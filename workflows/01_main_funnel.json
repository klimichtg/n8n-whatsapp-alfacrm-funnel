              "id": "c3",
              "leftValue": "={{ ($json.data?.key?.remoteJid || '').endsWith('@g.us') }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals", "singleValue": true }
            }
          ],
