# Public-facing host where n8n is reachable from Evolution API.
# In production this is your VPS hostname behind a reverse proxy (Caddy).
N8N_HOST=n8n.example.com
EVOLUTION_HOST=evo.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_PORT=5678
EVOLUTION_PORT=8080
TIMEZONE=Europe/Moscow

# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_me_with_openssl_rand_hex_32

# Postgres
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_me

# Evolution API
# - EVOLUTION_API_KEY: global apikey (header: apikey) — instances inherit unless overridden
# - EVOLUTION_HMAC_KEY: optional HMAC-SHA256 secret over webhook body for stronger auth
# - EVOLUTION_INSTANCE: default instance name used by health check
EVOLUTION_API_KEY=replace_me_with_strong_random_value
EVOLUTION_HMAC_KEY=
EVOLUTION_INSTANCE=sales-bot-1

# AlfaCRM
ALFACRM_HOSTNAME=demo.s20.online
ALFACRM_EMAIL=integration@example.com
ALFACRM_API_KEY=
ALFACRM_BRANCH_ID=1
ALFACRM_DEFAULT_LEAD_STATUS_ID=1
ALFACRM_WHATSAPP_LEAD_SOURCE_ID=1

# LLM (set whichever provider you use)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram (for hot-lead handoff + error/health alerts)
# - TELEGRAM_BOT_TOKEN: from @BotFather
# - TELEGRAM_SALES_CHAT_ID: channel/chat where hot leads are posted to managers
# - TELEGRAM_ALERT_CHAT_ID: channel for DevOps alerts (errors, health degradation)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SALES_CHAT_ID=
TELEGRAM_ALERT_CHAT_ID=
